# Aetherius VIVID live uplink. Unset = local deterministic engine.
#   http(s)://host/vivid  → POST {prompt}, Server-Sent Events back (data: text | {"delta": "..."} | [DONE])
#   ws(s)://host/vivid    → send {prompt}, receive the same payloads until [DONE] / {"done": true}
VITE_VIVID_API_URL=

# Absolute site origin used by og:url / og:image (no trailing slash).
VITE_SITE_URL=https://aetherius.example
