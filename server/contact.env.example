# Configuration for the contact-form mail relay (server/contact.mjs).
#
# Copy this to server/contact.env, fill in the password, and run scripts/deploy.sh —
# it installs the file at /etc/ail-website/contact.env as root-owned 0600 and points
# the systemd unit at it. server/contact.env is git-ignored; never commit a password.
#
#   cp server/contact.env.example server/contact.env
#   $EDITOR server/contact.env
#   ./scripts/deploy.sh

# --- sending mailbox -------------------------------------------------------
# The account the relay authenticates as. This address is what every message's
# From: header carries, because it is the domain that SPF and DKIM are aligned
# with — the visitor's own address goes into Reply-To instead.
#
# Gmail / Google Workspace needs an App Password here, not the account password:
# myaccount.google.com → Security → 2-Step Verification → App passwords.
# Port 465 would be implicit TLS; 587 is STARTTLS, which is what Gmail documents.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@orieninfotech.com
SMTP_PASSWORD=
SMTP_FROM=info@orieninfotech.com

# Force TLS mode instead of inferring it from the port (465 → true, else false).
#SMTP_SECURE=false

# --- receiving mailbox -----------------------------------------------------
# Where submissions land.
CONTACT_TO=info@aetheriuslabs.com

# Appears in the subject line and the mail footer.
CONTACT_SUBJECT_TAG=aetheriuslabs.com

# --- service ---------------------------------------------------------------
# Loopback only: nginx proxies /api/ here, nothing reaches it from outside.
#CONTACT_PORT=8787
#CONTACT_HOST=127.0.0.1

# Submissions per IP per window, and the window in milliseconds.
#CONTACT_RATE_LIMIT=5
#CONTACT_RATE_WINDOW_MS=600000

# A ceiling on sends across all visitors in 24h. Consumer Gmail cuts a sender off
# at 500/day and Workspace at 2000; running into that limit would take the whole
# mailbox down, not just the form.
#CONTACT_DAILY_LIMIT=120

# Nothing stores a submission, so one that fails to send is lost. By default the
# payload is printed to the journal on failure so it can be recovered by hand
# (journalctl -u ail-contact | grep 'LOST SUBMISSION'). Set to false to keep the
# sender's details out of the system log and accept the loss instead.
#CONTACT_LOG_FAILURES=true
